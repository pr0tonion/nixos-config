{
  config,
  pkgs,
  lib,
  ...
}:

{
  # Prometheus for metrics collection
  services.prometheus = {
    enable = true;
    port = 9090;
    listenAddress = "127.0.0.1"; # Grafana queries it locally; no need to expose it

    # Exporters for system metrics
    exporters = {
      # Node exporter for system metrics
      node = {
        enable = true;
        port = 9100;
        listenAddress = "127.0.0.1";
        enabledCollectors = [
          "systemd"
          "cpu"
          "diskstats"
          "filesystem"
          "loadavg"
          "meminfo"
          "netdev"
          "stat"
        ];
      };

      # Smartctl exporter for disk health
      smartctl = {
        enable = true;
        port = 9633;
        listenAddress = "127.0.0.1";
      };
    };

    # Scrape configurations
    scrapeConfigs = [
      {
        job_name = "node";
        static_configs = [
          {
            targets = [ "localhost:9100" ];
          }
        ];
        scrape_interval = "15s";
      }
      {
        job_name = "smartctl";
        static_configs = [
          {
            targets = [ "localhost:9633" ];
          }
        ];
        scrape_interval = "60s";
      }
      {
        job_name = "prometheus";
        static_configs = [
          {
            targets = [ "localhost:9090" ];
          }
        ];
      }
    ];

    # Retention period
    retentionTime = "30d";
  };

  # Grafana for visualization
  services.grafana = {
    enable = true;
    settings = {
      server = {
        http_port = 3000;
        http_addr = "0.0.0.0"; # Bind to all interfaces (LAN only)
      };
      analytics = {
        reporting_enabled = false;
      };
      security = {
        admin_user = "admin";
        # Both generated by grafana-secrets.service; read with:
        #   sudo cat /var/lib/grafana/admin_password
        admin_password = "$__file{/var/lib/grafana/admin_password}";
        secret_key = "$__file{/var/lib/grafana/secret_key}";
      };
    };

    # Provision Prometheus as a data source
    provision = {
      enable = true;
      datasources.settings.datasources = [
        {
          name = "Prometheus";
          type = "prometheus";
          url = "http://localhost:9090";
          isDefault = true;
        }
      ];
      # Pre-configured dashboards
      dashboards.settings.providers = [
        {
          name = "default";
          options.path = "/var/lib/grafana/dashboards";
        }
      ];
    };
  };

  # Loki for log aggregation
  services.loki = {
    enable = true;
    configuration = {
      # Loki has no auth (auth_enabled = false), so only Alloy and Grafana on this
      # host may reach it.
      server.http_listen_address = "127.0.0.1";
      server.http_listen_port = 3100;
      auth_enabled = false;

      ingester = {
        lifecycler = {
          address = "127.0.0.1";
          ring = {
            kvstore.store = "inmemory";
            replication_factor = 1;
          };
        };
        chunk_idle_period = "5m";
        chunk_retain_period = "30s";
      };

      schema_config = {
        configs = [
          {
            from = "2024-01-01";
            store = "tsdb";
            object_store = "filesystem";
            schema = "v13";
            index = {
              prefix = "index_";
              period = "24h";
            };
          }
        ];
      };

      storage_config = {
        tsdb_shipper = {
          active_index_directory = "/var/lib/loki/index";
          cache_location = "/var/lib/loki/cache";
        };
        filesystem = {
          directory = "/var/lib/loki/chunks";
        };
      };

      compactor = {
        working_directory = "/var/lib/loki/compactor";
        retention_enabled = true;
        delete_request_store = "filesystem";
      };

      limits_config = {
        retention_period = "744h"; # 31 days
      };
    };
  };

  # Grafana Alloy for log shipping to Loki (replaces Promtail, removed in 26.05).
  # The module runs Alloy with the systemd-journal group, so it can read the journal.
  services.alloy.enable = true;
  environment.etc."alloy/config.alloy".text = ''
    loki.relabel "journal" {
      forward_to = []

      rule {
        source_labels = ["__journal__systemd_unit"]
        target_label  = "unit"
      }
    }

    loki.source.journal "journal" {
      max_age       = "12h"
      relabel_rules = loki.relabel.journal.rules
      labels        = { job = "systemd-journal", host = "home-server" }
      forward_to    = [loki.write.local.receiver]
    }

    loki.write "local" {
      endpoint {
        url = "http://localhost:3100/loki/api/v1/push"
      }
    }
  '';

  # Only Grafana is reachable from the LAN. Prometheus, Loki and the exporters listen
  # on 127.0.0.1; use an SSH tunnel or Grafana's Explore view to reach them.
  networking.firewall.allowedTCPPorts = [ 3000 ];

  # Ensure monitoring user can access logs
  users.users.prometheus.extraGroups = [ "systemd-journal" ];

  # Generate Grafana's secret_key (encrypts data source credentials) and a random
  # initial admin password on first boot, so neither lands in the world-readable Nix
  # store. Never rotate secret_key: Grafana can't decrypt stored secrets if it changes.
  # admin_password only seeds the admin account on first start; later changes are
  # made in the Grafana UI.
  systemd.services.grafana-secrets = {
    description = "Generate Grafana secret key and initial admin password";
    wantedBy = [ "grafana.service" ];
    before = [ "grafana.service" ];
    serviceConfig.Type = "oneshot";
    script = ''
      install -d -m 0700 -o grafana -g grafana /var/lib/grafana
      for f in secret_key admin_password; do
        if [ ! -s /var/lib/grafana/$f ]; then
          (umask 077; ${pkgs.openssl}/bin/openssl rand -hex 32 > /var/lib/grafana/$f)
          chown grafana:grafana /var/lib/grafana/$f
        fi
      done
    '';
  };

  # Resource limits
  systemd.services.prometheus.serviceConfig = {
    MemoryMax = "2G";
    CPUQuota = "200%";
  };

  systemd.services.grafana.serviceConfig = {
    MemoryMax = "1G";
  };

  systemd.services.loki.serviceConfig = {
    MemoryMax = "1G";
  };

  # NOTE: After setup:
  # 1. Access Grafana at: http://<server-ip>:3000
  # 2. Log in as admin with the password from: sudo cat /var/lib/grafana/admin_password
  # 3. Prometheus will be auto-configured as a data source
  # 4. Import dashboards from grafana.com:
  #    - Node Exporter Full: Dashboard ID 1860
  #    - Prometheus Stats: Dashboard ID 2
  #    - Loki Logs: Dashboard ID 13639
  # 5. Prometheus is localhost-only: ssh -L 9090:localhost:9090 admin@home-server
}
